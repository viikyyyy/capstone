@page
@model Capstone.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Acceso";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hospital Aquiles Miro | Acceso</title>
    <style>
        :root { --ink:#0b4a63; --muted:#5c7f90; --sky:#4db8e8; --line:#cfe6f1; --bad:#b3261e; }
        * { box-sizing:border-box; }
        body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:28px 16px; background:linear-gradient(135deg,#fff 0%,#f3fbfe 100%); color:var(--ink); font-family:"Segoe UI",system-ui,sans-serif; }
        @if (Model.SelectedRole == "medico")
        {
            <text>body { background:#fff url('/images/Portal-Medico.jpeg?v=2') center/cover no-repeat; }</text>
        }
        else if (Model.SelectedRole == "paciente")
        {
            <text>body { background:#fff url('/images/Portal-Pacientes.jpeg?v=2') center/cover no-repeat; }</text>
        }
        .card { width:100%; max-width:420px; padding:32px 28px; background:white; border:1px solid #e3f1f8; border-radius:16px; box-shadow:0 10px 30px rgba(11,74,99,.08); text-align:center; }
        .brand { text-align:center; font-weight:700; letter-spacing:.04em; margin-bottom:20px; }
        .logo-mark { width:150px; height:auto; margin:0 auto 10px; display:block; }
        h1 { margin:0 0 5px; text-align:center; font-size:1.4rem; }
        .sub { margin:0 0 22px; text-align:center; color:var(--muted); font-size:.92rem; }
        label { display:block; margin:14px 0 6px; font-size:.85rem; font-weight:600; }
        input { width:100%; padding:11px 12px; border:1px solid var(--line); border-radius:10px; font:inherit; color:var(--ink); }
        input:focus { outline:3px solid rgba(77,184,232,.35); border-color:var(--sky); }
        button { width:100%; margin-top:20px; padding:12px; border:0; border-radius:10px; background:var(--sky); color:#06364d; font:inherit; font-weight:700; cursor:pointer; }
        button:hover { background:#38a8dc; }
        .error { margin-bottom:14px; color:var(--bad); text-align:center; font-size:.88rem; }
        .validation { color:var(--bad); font-size:.8rem; }
        .opts { display:flex; flex-direction:column; gap:14px; }
        .opt { display:flex; align-items:center; gap:14px; width:100%; padding:16px 18px; border:1px solid var(--line); border-radius:12px; background:#fff; cursor:pointer; text-align:left; font:inherit; color:var(--ink); }
        .opt:hover { background:#eaf7fd; border-color:var(--sky); }
        .ic { flex:0 0 auto; width:44px; height:44px; border-radius:10px; background:var(--sky); display:flex; align-items:center; justify-content:center; font-size:1.35rem; }
        .txt strong,.txt span { display:block; } .txt span { color:var(--muted); font-size:.82rem; margin-top:2px; } .arrow { margin-left:auto; color:#38a8dc; font-size:1.2rem; }
        .back { display:inline-block; margin-top:16px; color:var(--muted); font-size:.85rem; }
        .password { position:relative; } .password input { padding-right:70px; }
        .show-password { position:absolute; right:5px; top:50%; transform:translateY(-50%); width:auto; margin:0; padding:6px 8px; background:transparent; color:#1d7fa8; font-size:.8rem; }
        .links { margin-top:18px; padding-top:16px; border-top:1px solid #e9f3f8; text-align:center; font-size:.86rem; color:var(--muted); }
        .links a { color:#1d7fa8; }
    </style>
</head>
<body>
    <main class="card">
        <img class="logo-mark" src="/images/Logo.jpeg?v=2" alt="Hospital Aquiles Miro" />
        <div class="brand">HOSPITAL AQUILES MIRO</div>
        @if (Model.SelectedRole is null)
        {
            <h1>¿Cómo desea ingresar?</h1>
            <p class="sub">Selecciona tu tipo de usuario para continuar</p>
            <div class="opts">
                <a class="opt" href="?rol=medico"><span class="ic">⚕</span><span class="txt"><strong>Personal médico</strong><span>Médicos y equipo clínico</span></span><span class="arrow">›</span></a>
                <a class="opt" href="?rol=paciente"><span class="ic">●</span><span class="txt"><strong>Paciente</strong><span>Consulta tu ficha clínica</span></span><span class="arrow">›</span></a>
            </div>
        }
        else
        {
        <h1>¡Bienvenido!</h1>
        <p class="sub">@(Model.SelectedRole == "medico" ? "Portal de ingreso para médicos" : "Accede a tu ficha clínica")</p>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error" role="alert">@Model.ErrorMessage</div>
        }

        <form method="post">
            <input type="hidden" name="returnUrl" value="@Request.Query["returnUrl"]" />
            <input type="hidden" asp-for="Input.Rol" value="@Model.SelectedRole" />
            <label asp-for="Input.Identificador">Correo electrónico o RUT</label>
            <input asp-for="Input.Identificador" autocomplete="username" maxlength="120" autofocus />
            <span asp-validation-for="Input.Identificador" class="validation"></span>

            <label asp-for="Input.Contrasena">Contraseña</label>
            <div class="password">
                <input asp-for="Input.Contrasena" type="password" autocomplete="current-password" maxlength="128" />
                <button class="show-password" type="button" id="togglePassword">Mostrar</button>
            </div>
            <span asp-validation-for="Input.Contrasena" class="validation"></span>

            <button type="submit">Ingresar</button>
        </form>
        <div class="links">
            <a href="#">¿Olvidaste tu contraseña?</a>
        </div>
        <a class="back" href="/Account/Login">← Cambiar tipo de usuario</a>
        }
    </main>
    <script>
        const password = document.getElementById('Input_Contrasena');
        const toggle = document.getElementById('togglePassword');
        if (password && toggle) toggle.addEventListener('click', () => {
            const visible = password.type === 'password';
            password.type = visible ? 'text' : 'password';
            toggle.textContent = visible ? 'Ocultar' : 'Mostrar';
        });
    </script>
</body>
</html>
