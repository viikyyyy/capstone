@page
@model Capstone.Pages.CrearFichaModel
<div class="container py-4"><h1>Crear ficha clínica</h1><form method="post" class="col-md-8">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<label class="form-label">Paciente existente</label><select class="form-select" asp-for="Ficha.IdPaciente"><option value="0">Seleccione un paciente</option>@foreach(var p in Model.Pacientes){<option value="@p.IdPaciente">@p.Pnombre @p.Apellidop - @p.Rut-@p.DvRut</option>}</select>
<div class="form-check my-3"><input class="form-check-input" asp-for="CrearUsuario" id="crearUsuario" /><label class="form-check-label" for="crearUsuario">Crear nuevo paciente y acceso al portal</label></div>
<div class="border rounded p-3 mb-3 bg-light"><h2 class="h6">Datos del nuevo paciente</h2><div class="row g-2"><div class="col-md-3"><input class="form-control" asp-for="NuevoPaciente.Rut" placeholder="RUT" /></div><div class="col-md-2"><input class="form-control" asp-for="NuevoPaciente.DvRut" placeholder="DV" /></div><div class="col-md-3"><input class="form-control" asp-for="NuevoPaciente.Pnombre" placeholder="Nombre" /></div><div class="col-md-4"><input class="form-control" asp-for="NuevoPaciente.Apellidop" placeholder="Apellido" /></div><div class="col-md-6"><input class="form-control" asp-for="NuevoPaciente.Correo" type="email" placeholder="Correo de acceso" /></div><div class="col-md-6"><input class="form-control" asp-for="NuevoPaciente.Contrasena" type="password" placeholder="Contraseña inicial" /></div><div class="col-md-4"><input class="form-control" asp-for="NuevoPaciente.FechaNacimiento" type="date" /></div></div><small class="text-muted">El paciente podrá ingresar con este correo y contraseña.</small></div>
<label class="form-label">Fecha de atención</label><input class="form-control" asp-for="Ficha.FechaAtencion" type="datetime-local" />
<label class="form-label">Motivo de consulta</label><input class="form-control" asp-for="Ficha.MotivoConsulta" required />
<label class="form-label">Diagnóstico</label><textarea class="form-control" asp-for="Ficha.Diagnostico"></textarea>
<label class="form-label">Tratamiento</label><textarea class="form-control" asp-for="Ficha.Tratamiento"></textarea>
<label class="form-label">Observaciones</label><textarea class="form-control" asp-for="Ficha.Observaciones"></textarea>
<button class="btn btn-primary mt-3">Guardar ficha</button> <a class="btn btn-secondary mt-3" href="/">Cancelar</a></form></div>
