@page
@model Capstone.Pages.DetallePacienteModel
<div class="container py-4">
    <a href="/Pacientes">← Pacientes</a>
    <h1 class="mt-3">@Model.Paciente?.Pnombre @Model.Paciente?.Apellidop</h1>
    <p>RUT: @Model.Paciente?.Rut-@Model.Paciente?.DvRut</p>
    <h2>Historial de fichas</h2>
    @foreach (var ficha in Model.Fichas)
    {
        <div class="card mb-3"><div class="card-body">
            <h5>@ficha.MotivoConsulta</h5>
            <p><strong>Fecha:</strong> @ficha.FechaAtencion.ToString("dd/MM/yyyy")</p>
            <p><strong>Profesional:</strong> @ficha.Usuario?.Pnombre @ficha.Usuario?.Apellidop (@ficha.Usuario?.Rol)</p>
            <p>@ficha.Diagnostico</p><p>@ficha.Tratamiento</p>
            @if (ficha.Archivos.Count > 0) { <h6>Archivos</h6><ul>@foreach (var archivo in ficha.Archivos) { <li><a href="/DescargarArchivo?id_archivo=@archivo.IdArchivo">@archivo.NombreArchivo</a></li> }</ul> }
            <a class="btn btn-sm btn-outline-primary" href="/EditarFicha?id_ficha=@ficha.IdFicha">Editar ficha</a>
            <a class="btn btn-sm btn-outline-secondary ms-2" href="/SubirArchivo?IdFicha=@ficha.IdFicha">Adjuntar archivo</a>
        </div></div>
    }
</div>
