@page
@model Capstone.Pages.EditarFichaModel
<div class="container py-4"><h1>Editar ficha clínica</h1>
<form method="post" class="col-md-7">
    <input type="hidden" asp-for="Ficha.IdFicha" />
    <label class="form-label">Fecha de atención</label><input class="form-control" asp-for="Ficha.FechaAtencion" type="datetime-local" />
    <label class="form-label">Motivo de consulta</label><input class="form-control" asp-for="Ficha.MotivoConsulta" required />
    <label class="form-label">Diagnóstico</label><textarea class="form-control" asp-for="Ficha.Diagnostico"></textarea>
    <label class="form-label">Tratamiento</label><textarea class="form-control" asp-for="Ficha.Tratamiento"></textarea>
    <label class="form-label">Observaciones</label><textarea class="form-control" asp-for="Ficha.Observaciones"></textarea>
    <button class="btn btn-primary mt-3">Guardar cambios</button>
    <a class="btn btn-secondary mt-3" href="/">Cancelar</a>
</form></div>
