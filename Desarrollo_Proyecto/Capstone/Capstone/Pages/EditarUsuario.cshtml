@page
@model Capstone.Pages.EditarUsuarioModel
<div class="container py-4"><h1>Editar usuario</h1><form method="post" class="col-md-6"><input type="hidden" asp-for="Datos.IdUsuario" /><input type="hidden" asp-for="Datos.Rut" /><input type="hidden" asp-for="Datos.DvRut" /><label class="form-label">Nombre</label><input class="form-control" asp-for="Datos.Pnombre" required /><label class="form-label">Apellido</label><input class="form-control" asp-for="Datos.Apellidop" required /><label class="form-label">Correo</label><input class="form-control" asp-for="Datos.Correo" type="email" required /><label class="form-label">Rol</label><select class="form-select" asp-for="Datos.Rol"><option>paciente</option><option>medico</option><option>administrativo</option></select><label class="form-label">Estado</label><select class="form-select" asp-for="Datos.Estado"><option>activo</option><option>inactivo</option></select><label class="form-label">Nueva contraseña (opcional)</label><input class="form-control" asp-for="NuevaContrasena" type="password" /><button class="btn btn-primary mt-3">Guardar</button> <a class="btn btn-secondary mt-3" href="/GestionUsuarios">Cancelar</a></form></div>
