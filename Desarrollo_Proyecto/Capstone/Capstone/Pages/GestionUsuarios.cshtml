@page
@model Capstone.Pages.GestionUsuariosModel
<div class="container py-4"><div class="d-flex justify-content-between"><h1>Gestión de usuarios</h1><a class="btn btn-outline-secondary" href="/">Volver</a></div>
@if(Model.Mensaje != null){<div class="alert alert-success">@Model.Mensaje</div>} @if(Model.ErrorMessage != null){<div class="alert alert-danger">@Model.ErrorMessage</div>}
<h2 class="h4 mt-4">Crear usuario</h2><form method="post" asp-page-handler="Crear" class="row g-2">
<div class="col-md-2"><input class="form-control" asp-for="Nuevo.Rut" placeholder="RUT sin DV" /></div><div class="col-md-1"><input class="form-control" asp-for="Nuevo.DvRut" placeholder="DV" /></div><div class="col-md-2"><input class="form-control" asp-for="Nuevo.Pnombre" placeholder="Nombre" /></div><div class="col-md-2"><input class="form-control" asp-for="Nuevo.Apellidop" placeholder="Apellido" /></div><div class="col-md-3"><input class="form-control" asp-for="Nuevo.Correo" placeholder="Correo" /></div><div class="col-md-2"><input class="form-control" asp-for="Nuevo.Contrasena" type="password" placeholder="Contraseña" /></div><div class="col-md-2"><select class="form-select" asp-for="Nuevo.Rol"><option>paciente</option><option>medico</option><option>administrativo</option></select></div><div class="col-md-2"><button class="btn btn-primary">Crear</button></div></form>
<h2 class="h4 mt-5">Usuarios registrados</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Nombre</th><th>RUT</th><th>Correo</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var u in Model.Usuarios){<tr><td>@u.Pnombre @u.Apellidop</td><td>@u.Rut-@u.DvRut</td><td>@u.Correo</td><td>@u.Rol</td><td>@u.Estado</td><td><a class="btn btn-sm btn-outline-primary" href="/EditarUsuario?id_usuario=@u.IdUsuario">Editar</a> <form class="d-inline" method="post" asp-page-handler="CambiarEstado"><input type="hidden" name="idUsuario" value="@u.IdUsuario" /><button class="btn btn-sm btn-outline-warning">Cambiar estado</button></form></td></tr>}</tbody></table></div></div>
