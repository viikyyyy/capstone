@page
@model IndexModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="container py-4">
    <div class="mb-4"><h1 class="fw-bold">Dashboard</h1><p class="text-muted mb-0">Bienvenido, <strong>@Model.Nombre</strong> · <span class="badge text-bg-info">@Model.Rol</span></p></div>
    <div class="row g-3 mb-4"><div class="col-md-4"><div class="card h-100"><div class="card-body"><span class="fs-4">♙</span><h6 class="text-muted mt-2">Pacientes</h6><h2>@Model.Pacientes</h2></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><span class="fs-4">▣</span><h6 class="text-muted mt-2">Fichas de hoy</h6><h2>@Model.FichasHoy</h2></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><span class="fs-4">◷</span><h6 class="text-muted mt-2">Fichas este mes</h6><h2>@Model.FichasMes</h2></div></div></div></div>
    <div class="card mb-4"><div class="card-body"><h2 class="h4">Accesos directos</h2><div class="d-flex gap-2 flex-wrap"><a class="btn btn-primary" href="/Pacientes">⌕ Pacientes</a><a class="btn btn-outline-primary" href="/CrearFicha">＋ Crear ficha</a><a class="btn btn-outline-secondary" href="/Perfil">♙ Mi perfil</a>@if(Model.Rol.Equals("administrativo", StringComparison.OrdinalIgnoreCase) || Model.Rol.Equals("admin", StringComparison.OrdinalIgnoreCase)){<a class="btn btn-outline-dark" href="/Auditoria">▤ Auditoría</a><a class="btn btn-outline-dark" href="/Respaldos">▣ Respaldos</a><a class="btn btn-outline-dark" href="/GestionUsuarios">⚙ Usuarios</a>}</div></div></div>
    <div class="card"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Últimas fichas</h2><a href="/Pacientes" class="btn btn-sm btn-outline-secondary">Ver pacientes</a></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Paciente</th><th>Fecha</th><th>Motivo</th><th></th></tr></thead><tbody>@foreach(var ficha in Model.UltimasFichas){<tr><td>@ficha.Paciente</td><td>@ficha.FechaAtencion.ToString("dd/MM/yyyy HH:mm")</td><td>@ficha.Motivo</td><td><a class="btn btn-sm btn-outline-primary" href="/DetallePaciente?id_paciente=@ficha.IdPaciente">Ver</a> <a class="btn btn-sm btn-outline-secondary" href="/EditarFicha?id_ficha=@ficha.IdFicha">Editar</a></td></tr>}</tbody></table></div></div></div>
</div>
