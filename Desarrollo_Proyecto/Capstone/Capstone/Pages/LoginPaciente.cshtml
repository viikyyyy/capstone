@page
@model Capstone.Pages.LoginPacienteModel
@{
    Layout = null;
    ViewData["Title"] = "Portal pacientes";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hospital Aquiles Miro | Portal pacientes</title>
    <style>
        * { box-sizing:border-box; } body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px 16px; color:#0b4a63; font-family:"Segoe UI",system-ui,sans-serif; background:#fff url('/images/Portal-Pacientes.jpeg?v=3') center/cover no-repeat; }
        .card { width:100%; max-width:390px; padding:28px 26px; background:#fff; border:1px solid #dceef5; border-radius:16px; box-shadow:0 10px 30px #0b4a6320; } .logo { width:140px; display:block; margin:0 auto 8px; } h1 { text-align:center; font-size:1.3rem; margin:0 0 4px; } .sub { text-align:center; color:#5c7f90; margin:0 0 20px; font-size:.9rem; } label { display:block; margin:12px 0 6px; font-size:.85rem; font-weight:600; } input { width:100%; padding:11px 12px; border:1px solid #cfe6f1; border-radius:10px; font:inherit; } button { width:100%; margin-top:20px; padding:12px; border:0; border-radius:10px; background:#4db8e8; color:#06364d; font-weight:700; cursor:pointer; } .error,.validation { color:#b3261e; font-size:.85rem; } .back { display:block; margin-top:16px; text-align:center; color:#1d7fa8; font-size:.85rem; }
    </style>
</head>
<body>
    <main class="card">
        <img class="logo" src="/images/Logo.jpeg?v=3" alt="Hospital Aquiles Miro" />
        <h1>Portal pacientes</h1>
        <p class="sub">Consulta tu ficha clínica</p>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="error" role="alert">@Model.ErrorMessage</div> }
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Request.Query["returnUrl"]" />
            <label asp-for="Input.Identificador">Correo electrónico o RUT</label>
            <input asp-for="Input.Identificador" id="identificador" autocomplete="username" maxlength="120" autofocus />
            <span asp-validation-for="Input.Identificador" class="validation"></span>
            <label asp-for="Input.Contrasena">Contraseña</label>
            <input asp-for="Input.Contrasena" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.Contrasena" class="validation"></span>
            <button type="submit">Ingresar</button>
        </form>
        <a class="back" href="/RecuperarContrasena">¿Olvidaste tu contraseña?</a><a class="back" href="/SelectorIngreso">← Cambiar tipo de usuario</a>
    </main>
    <script>
        const identificador = document.getElementById('identificador');
        identificador?.addEventListener('input', () => {
            const valor = identificador.value.replace(/[^0-9kK]/g, '').toUpperCase();
            if (!/^\d/.test(valor)) return;
            if (valor.length < 8) { identificador.value = valor; return; }
            const cuerpo = valor.slice(0, -1).slice(0, 8);
            const dv = valor.slice(-1);
            identificador.value = cuerpo.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '-' + dv;
        });
    </script>
</body>
</html>
