@page
@model Capstone.Pages.MisFichasModel
@{
    ViewData["Title"] = "Mis fichas";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><h1>Mis fichas clínicas</h1><a class="btn btn-outline-secondary" href="/">Volver al dashboard</a></div>
    @if (Model.Fichas.Count == 0) { <p class="text-muted">No tienes fichas clínicas registradas.</p> }
    @foreach (var ficha in Model.Fichas)
    {
        <article class="card mb-3"><div class="card-body"><h5>@ficha.MotivoConsulta</h5><p class="text-muted">Atención: @ficha.FechaAtencion.ToString("dd/MM/yyyy")</p><p><strong>Diagnóstico:</strong> @ficha.Diagnostico</p><p><strong>Tratamiento:</strong> @ficha.Tratamiento</p>@if(ficha.Archivos.Count > 0){<h6>Archivos adjuntos</h6><ul>@foreach(var archivo in ficha.Archivos){<li><a href="/DescargarArchivo?id_archivo=@archivo.IdArchivo">@archivo.NombreArchivo</a></li>}</ul>}</div></article>
    }
</div>
