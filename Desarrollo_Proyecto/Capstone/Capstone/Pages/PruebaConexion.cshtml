@page
@model Capstone.Pages.PruebaConexionModel
@{
    ViewData["Title"] = "Prueba de conexión";
}

<h1>Prueba de conexión</h1>

@if (Model.ConexionExitosa)
{
    <div class="alert alert-success" role="alert">
        <strong>Conexión exitosa.</strong>
        <p>@Model.Mensaje</p>
        <p>Usuarios registrados: <strong>@Model.CantidadUsuarios</strong></p>
    </div>
}
else
{
    <div class="alert alert-danger" role="alert">
        <strong>Conexión fallida.</strong>
        <p>@Model.Mensaje</p>
    </div>
}
