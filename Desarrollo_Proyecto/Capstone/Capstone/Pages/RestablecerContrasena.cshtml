@page
@model Capstone.Pages.RestablecerContrasenaModel
<div class="container py-5"><div class="card col-md-6 mx-auto"><div class="card-body"><h1>Restablecer contraseña</h1><form method="post"><label class="form-label">Correo</label><input class="form-control" asp-for="Correo" required /><label class="form-label">Código</label><input class="form-control" asp-for="Codigo" required /><label class="form-label">Nueva contraseña</label><input class="form-control" asp-for="NuevaContrasena" type="password" minlength="8" required /><button class="btn btn-primary mt-3">Actualizar contraseña</button></form>@if(Model.Mensaje != null){<div class="alert alert-info mt-3">@Model.Mensaje</div>}</div></div></div>
