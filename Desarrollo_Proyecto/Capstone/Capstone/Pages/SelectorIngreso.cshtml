@page
@model Capstone.Pages.SelectorIngresoModel
@{
    Layout = null;
    ViewData["Title"] = "Seleccionar ingreso";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hospital Aquiles Miro | Acceso</title>
    <style>
        :root { --ink:#0b4a63; --muted:#5c7f90; --sky:#4db8e8; --line:#cfe6f1; }
        * { box-sizing:border-box; }
        body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:28px 16px; background:#fff; color:var(--ink); font-family:"Segoe UI",system-ui,sans-serif; }
        .card { width:100%; max-width:420px; padding:32px 28px; background:#fff; border:1px solid #e3f1f8; border-radius:16px; box-shadow:0 10px 30px rgba(11,74,99,.08); text-align:center; }
        .logo { width:150px; height:auto; display:block; margin:0 auto 10px; }
        h1 { margin:0 0 5px; font-size:1.35rem; } .sub { margin:0 0 24px; color:var(--muted); font-size:.92rem; }
        .opts { display:flex; flex-direction:column; gap:14px; }
        .opt { display:flex; align-items:center; gap:14px; width:100%; padding:16px 18px; border:1px solid var(--line); border-radius:12px; background:#fff; color:var(--ink); text-align:left; text-decoration:none; transition:.15s; }
        .opt:hover { background:#eaf7fd; border-color:var(--sky); }
        .ic { width:44px; height:44px; display:flex; align-items:center; justify-content:center; border-radius:10px; background:var(--sky); font-size:1.35rem; }
        .txt strong,.txt span { display:block; } .txt span { margin-top:2px; color:var(--muted); font-size:.82rem; } .arrow { margin-left:auto; color:#38a8dc; font-size:1.2rem; }
    </style>
</head>
<body>
    <main class="card">
        <img class="logo" src="/images/Logo.jpeg?v=3" alt="Hospital Aquiles Miro" />
        <h1>¿Cómo desea ingresar?</h1>
        <p class="sub">Selecciona tu tipo de usuario para continuar</p>
        <div class="opts">
            <a class="opt" href="/LoginMedico">
                <span class="ic" aria-hidden="true">⚕</span>
                <span class="txt"><strong>Personal médico y administrativo</strong><span>Acceso al portal institucional</span></span>
                <span class="arrow" aria-hidden="true">›</span>
            </a>
            <a class="opt" href="/LoginPaciente">
                <span class="ic" aria-hidden="true">●</span>
                <span class="txt"><strong>Paciente</strong><span>Consulta tu ficha clínica</span></span>
                <span class="arrow" aria-hidden="true">›</span>
            </a>
        </div>
    </main>
</body>
</html>
